# WhatsApp da empresa: formato internacional, apenas dígitos (ex.: 55 + DDD + número).
# Deixe vazio enquanto o número não for confirmado — o site oferecerá "Copiar seleção".
VITE_WHATSAPP_NUMBER=554999796208

# true = modo de demonstração (faixa de aviso, itens de exemplo visíveis, noindex).
# Defina false somente quando o catálogo real estiver cadastrado.
VITE_DEMO_MODE=true

# PIN de acesso ao painel /#/admin (proteção apenas de interface; veja README).
# Vazio = painel desativado. Defina o seu no .env local ou nas variáveis do Lovable.
VITE_ADMIN_PIN=
